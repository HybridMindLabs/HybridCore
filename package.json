        "@tailwindcss/vite": "^4.3.5",
        "@vitejs/plugin-vue": "^6.0.10",
        "concurrently": "^10.0.7",
        "eslint": "^10.14.0",
        "eslint-plugin-vue": "^10.12.0",
        "globals": "^17.14.0",
        "laravel-vite-plugin": "^3.2",
        "tailwindcss": "^4.0.0",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.72.1",
        "vite": "^8.3.6",
        "vue": "^3.5.45"
