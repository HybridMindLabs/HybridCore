{
    "$schema": "https://www.schemastore.org/package.json",
    "name": "hybridcore",
    "version": "0.11.2",
    "description": "Frontend for HybridCore — a modular self-hosted platform for gaming communities.",
    "license": "UNLICENSED",
    "private": true,
    "type": "module",
    "engines": {
        "node": ">=20"
