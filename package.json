        "@tailwindcss/vite": "^4.3.3",
        "@vitejs/plugin-vue": "^6.0.8",
        "concurrently": "^9.0.1",
        "eslint": "^10.8.0",
        "eslint-plugin-vue": "^10.10.0",
        "globals": "^17.8.0",
        "laravel-vite-plugin": "^3.1",
        "tailwindcss": "^4.0.0",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.65.0",
        "vite": "^8.2.0",
        "vue": "^3.5.40"
    },
    "dependencies": {
