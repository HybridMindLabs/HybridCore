        "@tailwindcss/vite": "^4.3.3",
        "@vitejs/plugin-vue": "^6.0.10",
        "concurrently": "^10.0.5",
        "eslint": "^10.12.0",
        "eslint-plugin-vue": "^10.11.1",
        "globals": "^17.13.0",
        "laravel-vite-plugin": "^3.2",
        "tailwindcss": "^4.0.0",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.71.2",
        "vite": "^8.3.4",
        "vue": "^3.5.44"
